<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>점심 가계부</title>
<style>
  :root{
    --bg:#F5F6F8;
    --surface:#FFFFFF;
    --line:#EEF0F2;
    --text:#191F28;
    --text-sub:#8B95A1;
    --text-faint:#B0B8C1;
    --blue:#3182F6;
    --blue-dark:#1B64DA;
    --blue-rgb:49,130,246;
    --mint:#02C2B4;
    --red:#F04452;
    --red-bg:#FFF0F1;
    --mint-bg:#E6FAF7;
    --blue-bg:#EAF2FF;
    --radius-lg:22px;
    --radius-md:16px;
    --radius-sm:12px;
    --shadow: 0 8px 24px rgba(25,31,40,0.06);
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Pretendard","Malgun Gothic","Apple SD Gothic Neo",sans-serif;
    color:var(--text);
    display:flex;
    justify-content:center;
    min-height:100vh;
  }
  #app{
    width:100%;
    max-width:430px;
    min-height:100vh;
    background:var(--bg);
    position:relative;
    display:flex;
    flex-direction:column;
    padding-bottom:110px;
  }

  /* header */
  header{
    position:sticky; top:0; z-index:20;
    background:rgba(245,246,248,0.92);
    backdrop-filter:blur(10px);
    padding:18px 20px 10px;
  }
  .headline{
    display:flex; align-items:center; justify-content:space-between;
  }
  .headline h1{
    font-size:19px; font-weight:800; margin:0; letter-spacing:-0.3px;
  }
  .icon-btn{
    width:36px; height:36px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    background:var(--surface); border:none; box-shadow:var(--shadow);
    cursor:pointer; color:var(--text-sub);
  }
  .month-nav{
    display:flex; align-items:center; justify-content:center; gap:14px;
    margin-top:10px;
  }
  .month-nav button{
    background:none; border:none; padding:6px; cursor:pointer; color:var(--text-faint);
    display:flex; align-items:center;
  }
  .month-nav .month-label{
    font-size:15px; font-weight:700; color:var(--text-sub); min-width:96px; text-align:center;
  }

  main{ padding:6px 20px 0; flex:1; }

  /* hero card */
  .hero{
    background:linear-gradient(135deg, var(--blue) 0%, var(--blue-dark) 100%);
    border-radius:var(--radius-lg);
    padding:26px 24px 22px;
    color:#fff;
    box-shadow:0 14px 30px rgba(var(--blue-rgb),0.28);
    margin-top:6px;
  }
  .hero.over{
    background:linear-gradient(135deg,#F04452 0%, #D8303F 60%, #B8202E 100%);
    box-shadow:0 14px 30px rgba(240,68,82,0.28);
  }
  .hero-label{ font-size:13px; opacity:0.85; font-weight:600; }
  .hero-amount{ font-size:34px; font-weight:800; margin-top:6px; letter-spacing:-0.5px; }
  .hero-bar{
    margin-top:16px; height:7px; border-radius:6px; background:rgba(255,255,255,0.28); overflow:hidden;
  }
  .hero-bar-fill{ height:100%; background:#fff; border-radius:6px; transition:width .35s ease; }
  .hero-stats{
    display:flex; justify-content:space-between; margin-top:16px;
  }
  .hero-stat{ font-size:12.5px; opacity:0.9; }
  .hero-stat b{ display:block; font-size:14.5px; font-weight:700; margin-top:2px; }

  /* today card */
  .today-card{
    background:var(--surface); border-radius:var(--radius-md);
    padding:16px 18px; margin-top:14px;
    display:flex; align-items:center; justify-content:space-between;
    box-shadow:var(--shadow);
  }
  .today-card .t-label{ font-size:13px; color:var(--text-sub); font-weight:600; }
  .today-card .t-amount{ font-size:19px; font-weight:800; margin-top:3px; }
  .badge{
    padding:6px 11px; border-radius:20px; font-size:12.5px; font-weight:700; white-space:nowrap;
  }
  .badge.over{ background:var(--red-bg); color:var(--red); }
  .badge.under{ background:var(--mint-bg); color:var(--mint); }
  .badge.blue{ background:var(--blue-bg); color:var(--blue); }

  /* list */
  .section-title{
    font-size:15px; font-weight:800; margin:26px 2px 10px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .view-toggle{
    display:flex; background:#EAECEF; border-radius:10px; padding:3px; gap:2px;
  }
  .view-toggle button{
    border:none; background:none; padding:6px 13px; border-radius:8px;
    font-size:12.5px; font-weight:700; color:var(--text-sub); cursor:pointer;
  }
  .view-toggle button.active{ background:#fff; color:var(--text); box-shadow:0 1px 3px rgba(25,31,40,0.12); }

  /* calendar */
  .cal-dow-row{ display:grid; grid-template-columns:repeat(7,1fr); gap:6px; margin-bottom:8px; }
  .cal-dow-row span{ text-align:center; font-size:11.5px; font-weight:700; color:var(--text-faint); }
  .cal-dow-row span:first-child{ color:var(--red); }
  .cal-dow-row span:last-child{ color:var(--blue); }
  .cal-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:6px; margin-bottom:8px; }
  .cal-cell{
    aspect-ratio:1; border-radius:12px; background:var(--surface);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    cursor:pointer; border:1.5px solid transparent; padding:2px; gap:2px;
    box-shadow:var(--shadow);
  }
  .cal-cell.empty{ background:transparent; box-shadow:none; cursor:default; }
  .cal-cell.today{ border-color:var(--blue); }
  .cal-cell.has-under{ background:var(--mint-bg); }
  .cal-cell.has-over{ background:var(--red-bg); }
  .cal-cell .cal-day{ font-size:12.5px; font-weight:700; color:var(--text); }
  .cal-cell .cal-amt{ font-size:9.5px; font-weight:700; color:var(--text-sub); }
  .cal-cell.has-over .cal-day{ color:var(--red); }
  .cal-cell.has-under .cal-day{ color:var(--mint); }
  .cal-cell.excluded{ background:#F1F2F4; }
  .cal-cell.excluded .cal-day{ color:var(--text-faint); }
  .cal-cell.excluded .cal-amt{ color:var(--text-faint); }
  .cal-legend{ display:flex; gap:14px; margin:2px 2px 4px; flex-wrap:wrap; }
  .cal-legend span{ font-size:11.5px; color:var(--text-sub); display:flex; align-items:center; gap:5px; }
  .cal-legend i{ width:8px; height:8px; border-radius:50%; display:inline-block; }

  /* color picker */
  .swatch-row{ display:flex; gap:12px; flex-wrap:wrap; margin-top:4px; }
  .swatch{
    width:34px; height:34px; border-radius:50%; border:2px solid transparent;
    cursor:pointer; position:relative; display:flex; align-items:center; justify-content:center;
  }
  .swatch.selected{ border-color:var(--text); }
  .swatch svg{ display:none; }
  .swatch.selected svg{ display:block; }

  /* excluded date manager */
  .excl-desc{ font-size:12px; color:var(--text-faint); line-height:1.5; margin:-4px 0 12px; }
  .excl-add-row{ display:flex; gap:8px; margin-bottom:10px; }
  .excl-add-row input{ flex:1; }
  .excl-add-row button{
    flex-shrink:0; padding:0 16px; border:none; border-radius:var(--radius-sm);
    background:var(--blue); color:#fff; font-weight:700; font-size:13.5px; cursor:pointer;
  }
  .excl-list{ display:flex; flex-direction:column; gap:8px; }
  .excl-chip{
    display:flex; align-items:center; justify-content:space-between;
    background:#FAFBFC; border:1.5px solid var(--line); border-radius:var(--radius-sm);
    padding:10px 12px; font-size:13.5px; font-weight:600;
  }
  .excl-chip button{ background:none; border:none; color:var(--text-faint); cursor:pointer; }
  .excl-empty{ font-size:12.5px; color:var(--text-faint); padding:6px 2px; }
  .day-toggle-btn{
    width:100%; padding:12px; border-radius:var(--radius-sm); border:1.5px solid var(--line);
    background:#fff; font-size:13.5px; font-weight:700; cursor:pointer; margin-bottom:14px;
  }
  .day-toggle-btn.on{ background:var(--red-bg); border-color:var(--red-bg); color:var(--red); }
  .day-group{ margin-bottom:16px; }
  .day-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:0 2px 8px;
  }
  .day-head .d-left{ display:flex; align-items:baseline; gap:6px; }
  .day-head .d-date{ font-size:13.5px; font-weight:700; color:var(--text); }
  .day-head .d-dow{ font-size:12px; color:var(--text-faint); font-weight:600; }
  .day-total{ font-size:12.5px; color:var(--text-sub); font-weight:600; }

  .entry-card{
    background:var(--surface); border-radius:var(--radius-sm);
    padding:14px 14px; margin-bottom:8px;
    display:flex; align-items:center; justify-content:space-between;
    box-shadow:var(--shadow);
    cursor:pointer;
  }
  .entry-card:active{ background:#FAFBFC; }
  .entry-left{ display:flex; flex-direction:column; gap:3px; min-width:0; }
  .entry-place{ font-size:14.5px; font-weight:700; color:var(--text); }
  .entry-menu{ font-size:13px; color:var(--text-sub); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .entry-right{ display:flex; align-items:center; gap:10px; flex-shrink:0; }
  .entry-price{ font-size:15px; font-weight:800; }
  .entry-chevron{
    color:var(--text-faint); display:flex; align-items:center; justify-content:center;
    width:20px; height:20px;
  }
  .ghost-btn.danger{ border-color:var(--red-bg); color:var(--red); background:var(--red-bg); }

  .empty-state{
    text-align:center; padding:50px 20px; color:var(--text-faint);
  }
  .empty-state .emoji{ font-size:34px; margin-bottom:10px; }
  .empty-state p{ font-size:13.5px; line-height:1.6; margin:0; }

  /* FAB */
  .fab{
    position:fixed; bottom:28px; left:50%; transform:translateX(calc(-50% + 145px));
    width:58px; height:58px; border-radius:50%;
    background:var(--blue); color:#fff; border:none;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 10px 24px rgba(var(--blue-rgb),0.4);
    cursor:pointer; z-index:30;
  }

  /* sheets */
  .overlay{
    position:fixed; inset:0; background:rgba(15,18,22,0.42);
    display:none; align-items:flex-end; justify-content:center; z-index:50;
  }
  .overlay.open{ display:flex; }
  .sheet{
    width:100%; max-width:430px; background:var(--surface);
    border-radius:24px 24px 0 0; padding:10px 22px 28px;
    max-height:88vh; overflow-y:auto;
    animation:slideUp .25s ease;
  }
  @keyframes slideUp{ from{ transform:translateY(24px); opacity:0; } to{ transform:translateY(0); opacity:1; } }
  .sheet-handle{ width:36px; height:4px; background:var(--line); border-radius:4px; margin:6px auto 14px; }
  .sheet-title{ font-size:18px; font-weight:800; margin-bottom:18px; }
  .field{ margin-bottom:14px; }
  .field label{ display:block; font-size:12.5px; font-weight:700; color:var(--text-sub); margin-bottom:7px; }
  .field input{
    width:100%; padding:13px 14px; border-radius:var(--radius-sm); border:1.5px solid var(--line);
    font-size:15px; font-family:inherit; color:var(--text); background:#FAFBFC;
    outline:none;
  }
  .field input:focus{ border-color:var(--blue); background:#fff; }
  .primary-btn{
    width:100%; padding:15px; border:none; border-radius:var(--radius-sm);
    background:var(--blue); color:#fff; font-size:15.5px; font-weight:700;
    cursor:pointer; margin-top:6px;
  }
  .primary-btn:active{ background:var(--blue-dark); }
  .ghost-btn{
    width:100%; padding:14px; border-radius:var(--radius-sm); border:1.5px solid var(--line);
    background:#fff; color:var(--text); font-size:14.5px; font-weight:700; cursor:pointer;
    display:flex; align-items:center; justify-content:center; gap:8px;
  }
  .divider-label{ font-size:12px; color:var(--text-faint); font-weight:700; margin:22px 0 10px; }
  .backup-row{ display:flex; flex-direction:column; gap:10px; }
  .close-x{ position:absolute; top:16px; right:18px; background:none;border:none;color:var(--text-faint);cursor:pointer; }
  .sheet-wrap{ position:relative; }
  .hint{ font-size:12px; color:var(--text-faint); margin-top:8px; line-height:1.5; }
  #loading{
    position:fixed; inset:0; background:var(--bg); display:flex; align-items:center; justify-content:center;
    z-index:100; color:var(--text-faint); font-size:13.5px;
  }
</style>
</head>
<body>

<div id="loading">불러오는 중...</div>
<div id="app" style="display:none;">

  <header>
    <div class="headline">
      <h1>점심 가계부</h1>
      <button class="icon-btn" id="openSettings" aria-label="설정">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      </button>
    </div>
    <div class="month-nav">
      <button id="prevMonth" aria-label="이전달">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <span class="month-label" id="monthLabel">2026년 9월</span>
      <button id="nextMonth" aria-label="다음달">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </header>

  <main>
    <div class="hero" id="heroCard">
      <div class="hero-label" id="heroLabel">이번달 남은 식비</div>
      <div class="hero-amount" id="heroAmount">0원</div>
      <div class="hero-bar"><div class="hero-bar-fill" id="heroBarFill" style="width:0%"></div></div>
      <div class="hero-stats">
        <div class="hero-stat">예산<b id="statBudget">0원</b></div>
        <div class="hero-stat">사용<b id="statUsed">0원</b></div>
        <div class="hero-stat">평일 평균<b id="statAvg">0원</b></div>
      </div>
    </div>

    <div class="today-card" id="todayCard" style="display:none;">
      <div>
        <div class="t-label">오늘 점심 식비</div>
        <div class="t-amount" id="todayAmount">0원</div>
      </div>
      <div class="badge" id="todayBadge">-</div>
    </div>

    <div class="section-title">
      <span>식비 기록</span>
      <div class="view-toggle">
        <button id="tabList" class="active">리스트</button>
        <button id="tabCal">캘린더</button>
      </div>
    </div>

    <div id="calendarArea" style="display:none;">
      <div class="cal-legend">
        <span><i style="background:var(--mint);"></i>예산 이내</span>
        <span><i style="background:var(--red);"></i>예산 초과</span>
        <span><i style="background:#C7CBD1;"></i>제외일(주말·수동)</span>
      </div>
      <div class="cal-dow-row">
        <span>일</span><span>월</span><span>화</span><span>수</span><span>목</span><span>금</span><span>토</span>
      </div>
      <div class="cal-grid" id="calGrid"></div>
    </div>

    <div id="listArea"></div>
  </main>

  <button class="fab" id="openAdd" aria-label="기록 추가">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
  </button>

  <!-- Add Entry Sheet -->
  <div class="overlay" id="addOverlay">
    <div class="sheet sheet-wrap">
      <div class="sheet-handle"></div>
      <button class="close-x" data-close="addOverlay">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="sheet-title" id="addSheetTitle">점심 기록 추가</div>
      <div class="field">
        <label>언제</label>
        <input type="date" id="inpDate">
      </div>
      <div class="field">
        <label>어디서</label>
        <input type="text" id="inpPlace" placeholder="예: 김밥천국 강남점" maxlength="30">
      </div>
      <div class="field">
        <label>무엇을</label>
        <input type="text" id="inpMenu" placeholder="예: 참치김밥 + 라면" maxlength="30">
      </div>
      <div class="field">
        <label>얼마에</label>
        <input type="number" id="inpPrice" placeholder="0" inputmode="numeric" min="0">
      </div>
      <button class="primary-btn" id="saveEntry">저장하기</button>
      <button class="ghost-btn danger" id="deleteEntryBtn" style="display:none; margin-top:10px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        이 기록 삭제하기
      </button>
    </div>
  </div>

  <!-- Settings Sheet -->
  <div class="overlay" id="settingsOverlay">
    <div class="sheet sheet-wrap">
      <div class="sheet-handle"></div>
      <button class="close-x" data-close="settingsOverlay">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="sheet-title">설정</div>
      <div class="field">
        <label>한달 점심 식비 예산</label>
        <input type="number" id="inpBudget" placeholder="예: 300000" inputmode="numeric" min="0">
      </div>
      <div class="field">
        <label>정산 시작일</label>
        <input type="number" id="inpPeriodStart" placeholder="1" inputmode="numeric" min="1" max="31">
      </div>
      <div class="field">
        <label>정산 종료일</label>
        <input type="number" id="inpPeriodEnd" placeholder="31" inputmode="numeric" min="1" max="31">
      </div>
      <div class="hint" style="margin-top:-6px; margin-bottom:14px;">시작일과 종료일을 각각 지정할 수 있어요. 예를 들어 시작일 25일, 종료일 24일이면 매달 25일부터 다음달 24일까지가 한 주기가 돼요. 예산은 그 안에서 평일에만 나눠 적용돼요.</div>
      <button class="primary-btn" id="saveBudget">예산 저장</button>

      <div class="divider-label">테마 컬러</div>
      <div class="swatch-row" id="swatchRow"></div>

      <div class="divider-label">예산 제외 날짜</div>
      <div class="excl-desc">공휴일, 회식, 출장 등 예산 계산에 넣지 않을 평일을 직접 추가하세요. 주말은 이미 자동으로 제외돼요.</div>
      <div class="excl-add-row">
        <input type="date" id="inpExcludeDate">
        <button id="addExcludeBtn">추가</button>
      </div>
      <div class="excl-list" id="exclList"></div>

      <div class="divider-label">데이터 백업</div>
      <div class="backup-row">
        <button class="ghost-btn" id="exportBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          백업 파일 다운로드
        </button>
        <button class="ghost-btn" id="importBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          백업 파일 불러오기
        </button>
        <input type="file" id="importFile" accept="application/json" style="display:none;">
      </div>
      <div class="hint">불러오기를 하면 현재 기기의 기록이 백업 파일 내용으로 모두 대체돼요.</div>
    </div>
  </div>

  <!-- Day Detail Sheet -->
  <div class="overlay" id="dayOverlay">
    <div class="sheet sheet-wrap">
      <div class="sheet-handle"></div>
      <button class="close-x" data-close="dayOverlay">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="sheet-title" id="dayTitle">-</div>
      <div class="badge" id="dayBadge" style="margin-bottom:10px; display:inline-block;">-</div>
      <button class="day-toggle-btn" id="dayExcludeToggle" style="display:none;"></button>
      <div id="dayEntries"></div>
      <button class="ghost-btn" id="dayAddBtn" style="margin-top:6px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        이 날짜에 기록 추가
      </button>
    </div>
  </div>

</div>

<script>
(function(){
  var state = { entries: [], budget: 0, viewYear: null, viewMonth: null, view: 'list', excludedDates: [], colorId: 'blue', periodStartDay: 1, periodEndDay: 31 };
  var today = new Date();
  var todayKey = fmtKey(today);

  var COLOR_PRESETS = [
    { id:'blue',   name:'토스 블루', base:'#3182F6', dark:'#1B64DA', bg:'#EAF2FF', rgb:'49,130,246' },
    { id:'mint',   name:'민트',      base:'#02C2B4', dark:'#019C90', bg:'#E6FAF7', rgb:'2,194,180' },
    { id:'coral',  name:'코랄',      base:'#FF6B4A', dark:'#E8532F', bg:'#FFEDE8', rgb:'255,107,74' },
    { id:'purple', name:'퍼플',      base:'#7C5CFC', dark:'#6042E0', bg:'#F1EDFF', rgb:'124,92,252' },
    { id:'amber',  name:'앰버',      base:'#FFB020', dark:'#E89600', bg:'#FFF3DE', rgb:'255,176,32' },
    { id:'slate',  name:'슬레이트',  base:'#5E6AD2', dark:'#4A54B0', bg:'#EEF0FC', rgb:'94,106,210' }
  ];

  function fmtKey(d){
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  }
  function won(n){
    n = Math.round(n||0);
    return n.toLocaleString('ko-KR') + '원';
  }
  function daysInMonth(y,m){ return new Date(y, m+1, 0).getDate(); }
  function dowLabel(d){ return ['일','월','화','수','목','금','토'][d.getDay()]; }
  function isWeekday(dateKey){
    var dow = new Date(dateKey+'T00:00:00').getDay();
    return dow!==0 && dow!==6;
  }
  function isBudgetDay(dateKey){
    return isWeekday(dateKey) && state.excludedDates.indexOf(dateKey)===-1;
  }
  function periodRange(y,m){
    var startDay = Math.min(Math.max(Number(state.periodStartDay)||1, 1), 31);
    var endDay = Math.min(Math.max(Number(state.periodEndDay)||31, 1), 31);
    var start = new Date(y, m, Math.min(startDay, daysInMonth(y,m)));
    var endMonth = endDay >= startDay ? m : m + 1;
    var endYear = y;
    if(endMonth > 11){ endMonth = 0; endYear++; }
    var end = new Date(endYear, endMonth, Math.min(endDay, daysInMonth(endYear,endMonth)));
    return { start: start, end: end, startKey: fmtKey(start), endKey: fmtKey(end) };
  }
  function forEachDateInRange(start, end, cb){
    var cur = new Date(start.getFullYear(), start.getMonth(), start.getDate());
    var endKey = fmtKey(end);
    while(fmtKey(cur) <= endKey){
      cb(cur);
      cur.setDate(cur.getDate()+1);
    }
  }
  function countBudgetDaysInMonth(y,m){
    var r = periodRange(y,m);
    var c = 0;
    forEachDateInRange(r.start, r.end, function(d){ if(isBudgetDay(fmtKey(d))) c++; });
    return c;
  }
  function applyColor(id){
    var preset = COLOR_PRESETS.filter(function(c){return c.id===id;})[0] || COLOR_PRESETS[0];
    var root = document.documentElement.style;
    root.setProperty('--blue', preset.base);
    root.setProperty('--blue-dark', preset.dark);
    root.setProperty('--blue-bg', preset.bg);
    root.setProperty('--blue-rgb', preset.rgb);
  }
  function renderSwatches(){
    var row = document.getElementById('swatchRow');
    row.innerHTML = '';
    COLOR_PRESETS.forEach(function(c){
      var sw = document.createElement('button');
      sw.className = 'swatch' + (state.colorId===c.id ? ' selected' : '');
      sw.style.background = c.base;
      sw.title = c.name;
      sw.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      sw.onclick = function(){
        state.colorId = c.id;
        applyColor(c.id);
        saveColor();
        renderSwatches();
      };
      row.appendChild(sw);
    });
  }

  async function loadData(){
    try{
      var e = await window.storage.get('lunch-entries', false);
      state.entries = e ? JSON.parse(e.value) : [];
    }catch(err){ state.entries = []; }
    try{
      var b = await window.storage.get('lunch-budget', false);
      state.budget = b ? JSON.parse(b.value) : 0;
    }catch(err){ state.budget = 0; }
    try{
      var x = await window.storage.get('lunch-excluded', false);
      state.excludedDates = x ? JSON.parse(x.value) : [];
    }catch(err){ state.excludedDates = []; }
    try{
      var c = await window.storage.get('lunch-color', false);
      state.colorId = c ? JSON.parse(c.value) : 'blue';
    }catch(err){ state.colorId = 'blue'; }
    try{
      var p = await window.storage.get('lunch-period-start', false);
      state.periodStartDay = p ? JSON.parse(p.value) : 1;
    }catch(err){ state.periodStartDay = 1; }
    try{
      var pe = await window.storage.get('lunch-period-end', false);
      state.periodEndDay = pe ? JSON.parse(pe.value) : 31;
    }catch(err){ state.periodEndDay = 31; }
  }
  async function saveEntries(){
    try{ await window.storage.set('lunch-entries', JSON.stringify(state.entries), false); }
    catch(err){ console.error('저장 실패', err); }
  }
  async function saveBudget(){
    try{ await window.storage.set('lunch-budget', JSON.stringify(state.budget), false); }
    catch(err){ console.error('저장 실패', err); }
  }
  async function saveExcluded(){
    try{ await window.storage.set('lunch-excluded', JSON.stringify(state.excludedDates), false); }
    catch(err){ console.error('저장 실패', err); }
  }
  async function saveColor(){
    try{ await window.storage.set('lunch-color', JSON.stringify(state.colorId), false); }
    catch(err){ console.error('저장 실패', err); }
  }
  async function savePeriodStart(){
    try{ await window.storage.set('lunch-period-start', JSON.stringify(state.periodStartDay), false); }
    catch(err){ console.error('저장 실패', err); }
  }
  async function savePeriodEnd(){
    try{ await window.storage.set('lunch-period-end', JSON.stringify(state.periodEndDay), false); }
    catch(err){ console.error('저장 실패', err); }
  }

  function monthEntries(){
    var r = periodRange(state.viewYear, state.viewMonth);
    return state.entries.filter(function(en){ return en.date >= r.startKey && en.date <= r.endKey; });
  }

  function render(){
    var r = periodRange(state.viewYear, state.viewMonth);
    var monthLabelEl = document.getElementById('monthLabel');
    if(state.periodStartDay===1 && state.periodEndDay===31){
      monthLabelEl.textContent = state.viewYear + '년 ' + (state.viewMonth+1) + '월';
    } else {
      monthLabelEl.textContent = (r.start.getMonth()+1)+'.'+r.start.getDate()+' - '+(r.end.getMonth()+1)+'.'+r.end.getDate();
    }

    var mEntries = monthEntries();
    var used = mEntries.filter(function(e){ return isBudgetDay(e.date); }).reduce(function(s,e){ return s+Number(e.price||0); }, 0);
    var budget = Number(state.budget||0);
    var remaining = budget - used;
    var budgetDaysInMonth = countBudgetDaysInMonth(state.viewYear, state.viewMonth);
    var dailyBudget = (budget > 0 && budgetDaysInMonth > 0) ? budget/budgetDaysInMonth : 0;
    var pct = budget>0 ? Math.min(100, (used/budget)*100) : 0;
    var isCurrentMonth = (todayKey >= r.startKey && todayKey <= r.endKey);
    var passedBudgetDays = 0;
    var countEndKey = todayKey > r.endKey ? r.endKey : (todayKey < r.startKey ? null : todayKey);
    if(countEndKey){
      forEachDateInRange(r.start, new Date(countEndKey+'T00:00:00'), function(d){ if(isBudgetDay(fmtKey(d))) passedBudgetDays++; });
    }
    var avgPerDay = passedBudgetDays>0 ? used/passedBudgetDays : 0;

    var periodLabel = (state.periodStartDay===1 && state.periodEndDay===31) ? (state.viewMonth+1)+'월' : '이번 기간';
    var hero = document.getElementById('heroCard');
    var heroLabel = document.getElementById('heroLabel');
    var heroAmount = document.getElementById('heroAmount');
    if(budget<=0){
      hero.classList.remove('over');
      heroLabel.textContent = periodLabel+' 사용한 식비';
      heroAmount.textContent = won(used);
    } else if(remaining>=0){
      hero.classList.remove('over');
      heroLabel.textContent = periodLabel+' 남은 식비';
      heroAmount.textContent = won(remaining);
    } else {
      hero.classList.add('over');
      heroLabel.textContent = periodLabel+' 예산 초과';
      heroAmount.textContent = won(Math.abs(remaining));
    }
    document.getElementById('heroBarFill').style.width = pct + '%';
    document.getElementById('statBudget').textContent = budget>0 ? won(budget) : '미설정';
    document.getElementById('statUsed').textContent = won(used);
    document.getElementById('statAvg').textContent = won(avgPerDay);

    // today card
    var todayCard = document.getElementById('todayCard');
    if(isCurrentMonth){
      todayCard.style.display = 'flex';
      var todaySpent = mEntries.filter(function(e){return e.date===todayKey;}).reduce(function(s,e){return s+Number(e.price||0);},0);
      document.getElementById('todayAmount').textContent = won(todaySpent);
      var badge = document.getElementById('todayBadge');
      if(!isBudgetDay(todayKey)){
        badge.className='badge blue'; badge.textContent = isWeekday(todayKey) ? '예산 제외일' : '주말 (예산 제외)';
      } else if(budget<=0){
        badge.className='badge blue'; badge.textContent='예산 미설정';
      } else if(todaySpent <= dailyBudget){
        badge.className='badge under'; badge.textContent = won(dailyBudget-todaySpent) + ' 남음';
      } else {
        badge.className='badge over'; badge.textContent = won(todaySpent-dailyBudget) + ' 오버';
      }
    } else {
      todayCard.style.display = 'none';
    }

    // group entries by date (used by both list & calendar)
    var groups = {};
    mEntries.forEach(function(e){
      if(!groups[e.date]) groups[e.date]=[];
      groups[e.date].push(e);
    });

    document.getElementById('listArea').style.display = state.view==='list' ? 'block' : 'none';
    document.getElementById('calendarArea').style.display = state.view==='calendar' ? 'block' : 'none';

    if(state.view==='calendar'){
      renderCalendar(groups, budget, dailyBudget);
      return;
    }

    // list grouped by date desc
    var dates = Object.keys(groups).sort().reverse();
    var listArea = document.getElementById('listArea');
    listArea.innerHTML = '';

    if(dates.length===0){
      listArea.innerHTML = '<div class="empty-state"><div class="emoji">🍱</div><p>아직 기록이 없어요.<br>오늘 점심을 기록해보세요.</p></div>';
      return;
    }

    dates.forEach(function(dateKey){
      var list = groups[dateKey];
      var dayTotal = list.reduce(function(s,e){return s+Number(e.price||0);},0);
      var dObj = new Date(dateKey+'T00:00:00');
      var group = document.createElement('div');
      group.className = 'day-group';

      var head = document.createElement('div');
      head.className = 'day-head';
      var dLeft = document.createElement('div');
      dLeft.className = 'd-left';
      var dDate = document.createElement('span');
      dDate.className='d-date';
      dDate.textContent = (dObj.getMonth()+1)+'월 '+dObj.getDate()+'일';
      var dDow = document.createElement('span');
      dDow.className='d-dow';
      dDow.textContent = dowLabel(dObj)+'요일';
      dLeft.appendChild(dDate); dLeft.appendChild(dDow);
      head.appendChild(dLeft);

      var right;
      if(!isBudgetDay(dateKey)){
        right = document.createElement('span');
        right.className = 'badge blue';
        right.style.fontSize='11.5px'; right.style.padding='4px 9px';
        right.textContent = won(dayTotal) + (isWeekday(dateKey) ? ' · 제외' : ' · 주말');
      } else if(budget>0){
        right = document.createElement('span');
        var diff = dailyBudget - dayTotal;
        right.className = 'badge ' + (diff>=0 ? 'under':'over');
        right.style.fontSize='11.5px'; right.style.padding='4px 9px';
        right.textContent = diff>=0 ? (won(diff)+' 남음') : (won(-diff)+' 오버');
      } else {
        right = document.createElement('span');
        right.className='day-total';
        right.textContent = won(dayTotal);
      }
      head.appendChild(right);
      group.appendChild(head);

      list.forEach(function(e){
        var card = document.createElement('div');
        card.className='entry-card';
        card.onclick = function(entry){ return function(){ openEditEntry(entry); }; }(e);
        var left = document.createElement('div');
        left.className='entry-left';
        var place = document.createElement('div');
        place.className='entry-place';
        place.textContent = e.place || '장소 미입력';
        var menu = document.createElement('div');
        menu.className='entry-menu';
        menu.textContent = e.menu || '';
        left.appendChild(place); left.appendChild(menu);

        var rightWrap = document.createElement('div');
        rightWrap.className='entry-right';
        var price = document.createElement('div');
        price.className='entry-price';
        price.textContent = won(e.price);
        var chevron = document.createElement('span');
        chevron.className='entry-chevron';
        chevron.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>';
        rightWrap.appendChild(price); rightWrap.appendChild(chevron);

        card.appendChild(left); card.appendChild(rightWrap);
        group.appendChild(card);
      });

      listArea.appendChild(group);
    });
  }

  function renderCalendar(groups, budget, dailyBudget){
    var grid = document.getElementById('calGrid');
    grid.innerHTML = '';
    var r = periodRange(state.viewYear, state.viewMonth);
    var firstDow = r.start.getDay();

    for(var i=0;i<firstDow;i++){
      var blank = document.createElement('div');
      blank.className = 'cal-cell empty';
      grid.appendChild(blank);
    }

    forEachDateInRange(r.start, r.end, function(dObj){
      var dateKey = fmtKey(dObj);
      var list = groups[dateKey] || [];
      var total = list.reduce(function(s,e){return s+Number(e.price||0);},0);

      var cell = document.createElement('div');
      cell.className = 'cal-cell';
      if(dateKey===todayKey) cell.classList.add('today');
      if(!isBudgetDay(dateKey)){
        cell.classList.add('excluded');
      } else if(list.length>0 && budget>0){
        cell.classList.add(total<=dailyBudget ? 'has-under' : 'has-over');
      }
      var dayNum = document.createElement('div');
      dayNum.className='cal-day';
      dayNum.textContent = (dObj.getDate()===1 && dateKey!==r.startKey) ? (dObj.getMonth()+1)+'.1' : dObj.getDate();
      cell.appendChild(dayNum);
      if(list.length>0){
        var amt = document.createElement('div');
        amt.className='cal-amt';
        amt.textContent = total>=10000 ? Math.round(total/1000)+'k' : total.toLocaleString('ko-KR');
        cell.appendChild(amt);
      }
      cell.onclick = function(dk){ return function(){ openDayDetail(dk); }; }(dateKey);
      grid.appendChild(cell);
    });
  }

  function openDayDetail(dateKey){
    var list = state.entries.filter(function(e){ return e.date===dateKey; });
    var dObj = new Date(dateKey+'T00:00:00');
    document.getElementById('dayTitle').textContent = (dObj.getMonth()+1)+'월 '+dObj.getDate()+'일 '+dowLabel(dObj)+'요일';

    var total = list.reduce(function(s,e){return s+Number(e.price||0);},0);
    var budgetDaysInMonth = countBudgetDaysInMonth(state.viewYear, state.viewMonth);
    var dailyBudget = (state.budget>0 && budgetDaysInMonth>0) ? state.budget/budgetDaysInMonth : 0;
    var badge = document.getElementById('dayBadge');
    var weekday = isWeekday(dateKey);
    var budgetDay = isBudgetDay(dateKey);

    if(!budgetDay){
      badge.className = 'badge blue';
      badge.textContent = weekday ? (won(total)+' 사용 · 예산 제외') : (won(total)+' 사용 · 주말');
    } else if(state.budget>0){
      var diff = dailyBudget - total;
      badge.className = 'badge ' + (diff>=0 ? 'under':'over');
      badge.textContent = diff>=0 ? (won(diff)+' 남음') : (won(-diff)+' 오버');
    } else {
      badge.className = 'badge blue';
      badge.textContent = won(total)+' 사용';
    }

    var toggleBtn = document.getElementById('dayExcludeToggle');
    if(weekday){
      toggleBtn.style.display = 'block';
      var isExcluded = state.excludedDates.indexOf(dateKey) !== -1;
      toggleBtn.className = 'day-toggle-btn' + (isExcluded ? ' on' : '');
      toggleBtn.textContent = isExcluded ? '✓ 이 날짜는 예산에서 제외됨 (탭하면 포함)' : '이 날짜를 예산에서 제외하기';
      toggleBtn.onclick = function(){
        var idx = state.excludedDates.indexOf(dateKey);
        if(idx===-1) state.excludedDates.push(dateKey);
        else state.excludedDates.splice(idx,1);
        saveExcluded();
        render();
        openDayDetail(dateKey);
      };
    } else {
      toggleBtn.style.display = 'none';
    }

    var wrap = document.getElementById('dayEntries');
    wrap.innerHTML = '';
    if(list.length===0){
      wrap.innerHTML = '<div class="empty-state" style="padding:26px 10px;"><p>이 날짜에는 기록이 없어요.</p></div>';
    } else {
      list.forEach(function(e){
        var card = document.createElement('div');
        card.className='entry-card';
        card.onclick = function(entry){ return function(){ closeSheet('dayOverlay'); openEditEntry(entry); }; }(e);
        var left = document.createElement('div');
        left.className='entry-left';
        var place = document.createElement('div');
        place.className='entry-place';
        place.textContent = e.place || '장소 미입력';
        var menu = document.createElement('div');
        menu.className='entry-menu';
        menu.textContent = e.menu || '';
        left.appendChild(place); left.appendChild(menu);

        var rightWrap = document.createElement('div');
        rightWrap.className='entry-right';
        var price = document.createElement('div');
        price.className='entry-price';
        price.textContent = won(e.price);
        var chevron = document.createElement('span');
        chevron.className='entry-chevron';
        chevron.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>';
        rightWrap.appendChild(price); rightWrap.appendChild(chevron);

        card.appendChild(left); card.appendChild(rightWrap);
        wrap.appendChild(card);
      });
    }

    document.getElementById('dayAddBtn').onclick = function(){
      closeSheet('dayOverlay');
      openAddSheet(dateKey);
    };

    openSheet('dayOverlay');
  }

  function deleteEntry(id){
    if(!confirm('이 기록을 삭제할까요?')) return;
    state.entries = state.entries.filter(function(e){ return e.id!==id; });
    saveEntries();
    render();
  }

  var editingId = null;

  function openAddSheet(dateKey){
    editingId = null;
    document.getElementById('addSheetTitle').textContent = '점심 기록 추가';
    document.getElementById('saveEntry').textContent = '저장하기';
    document.getElementById('deleteEntryBtn').style.display = 'none';
    document.getElementById('inpDate').value = dateKey || todayKey;
    document.getElementById('inpPlace').value='';
    document.getElementById('inpMenu').value='';
    document.getElementById('inpPrice').value='';
    openSheet('addOverlay');
  }

  function openEditEntry(entry){
    editingId = entry.id;
    document.getElementById('addSheetTitle').textContent = '점심 기록 수정';
    document.getElementById('saveEntry').textContent = '수정하기';
    document.getElementById('deleteEntryBtn').style.display = 'flex';
    document.getElementById('inpDate').value = entry.date;
    document.getElementById('inpPlace').value = entry.place || '';
    document.getElementById('inpMenu').value = entry.menu || '';
    document.getElementById('inpPrice').value = entry.price;
    openSheet('addOverlay');
  }

  function openSheet(id){ document.getElementById(id).classList.add('open'); }
  function closeSheet(id){ document.getElementById(id).classList.remove('open'); }

  document.querySelectorAll('[data-close]').forEach(function(btn){
    btn.onclick = function(){ closeSheet(btn.getAttribute('data-close')); };
  });
  document.getElementById('addOverlay').addEventListener('click', function(ev){
    if(ev.target===this) closeSheet('addOverlay');
  });
  document.getElementById('settingsOverlay').addEventListener('click', function(ev){
    if(ev.target===this) closeSheet('settingsOverlay');
  });

  document.getElementById('dayOverlay').addEventListener('click', function(ev){
    if(ev.target===this) closeSheet('dayOverlay');
  });

  document.getElementById('tabList').onclick = function(){
    state.view='list';
    this.classList.add('active');
    document.getElementById('tabCal').classList.remove('active');
    render();
  };
  document.getElementById('tabCal').onclick = function(){
    state.view='calendar';
    this.classList.add('active');
    document.getElementById('tabList').classList.remove('active');
    render();
  };

  document.getElementById('openAdd').onclick = function(){
    openAddSheet(todayKey);
  };

  document.getElementById('saveEntry').onclick = function(){
    var date = document.getElementById('inpDate').value;
    var place = document.getElementById('inpPlace').value.trim();
    var menu = document.getElementById('inpMenu').value.trim();
    var price = Number(document.getElementById('inpPrice').value);
    if(!date){ alert('날짜를 선택해주세요.'); return; }
    if(!price || price<=0){ alert('금액을 입력해주세요.'); return; }
    if(editingId){
      var target = state.entries.filter(function(e){ return e.id===editingId; })[0];
      if(target){
        target.date = date; target.place = place; target.menu = menu; target.price = price;
      }
    } else {
      state.entries.push({ id: Date.now()+'-'+Math.random().toString(36).slice(2,8), date: date, place: place, menu: menu, price: price });
    }
    saveEntries();
    state.viewYear = Number(date.slice(0,4));
    state.viewMonth = Number(date.slice(5,7))-1;
    editingId = null;
    closeSheet('addOverlay');
    render();
  };

  document.getElementById('deleteEntryBtn').onclick = function(){
    if(!editingId) return;
    if(!confirm('이 기록을 삭제할까요?')) return;
    state.entries = state.entries.filter(function(e){ return e.id!==editingId; });
    saveEntries();
    editingId = null;
    closeSheet('addOverlay');
    render();
  };

  function renderExcludedList(){
    var wrap = document.getElementById('exclList');
    wrap.innerHTML = '';
    var weekdayExcluded = state.excludedDates.filter(isWeekday).sort();
    if(weekdayExcluded.length===0){
      wrap.innerHTML = '<div class="excl-empty">추가된 제외 날짜가 없어요.</div>';
      return;
    }
    weekdayExcluded.forEach(function(dk){
      var dObj = new Date(dk+'T00:00:00');
      var chip = document.createElement('div');
      chip.className = 'excl-chip';
      var label = document.createElement('span');
      label.textContent = dObj.getFullYear()+'.'+(dObj.getMonth()+1)+'.'+dObj.getDate()+' ('+dowLabel(dObj)+')';
      var del = document.createElement('button');
      del.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
      del.onclick = function(){
        state.excludedDates = state.excludedDates.filter(function(d){ return d!==dk; });
        saveExcluded();
        renderExcludedList();
        render();
      };
      chip.appendChild(label); chip.appendChild(del);
      wrap.appendChild(chip);
    });
  }

  document.getElementById('addExcludeBtn').onclick = function(){
    var v = document.getElementById('inpExcludeDate').value;
    if(!v){ alert('날짜를 선택해주세요.'); return; }
    if(!isWeekday(v)){ alert('주말은 이미 자동으로 예산에서 제외돼요.'); return; }
    if(state.excludedDates.indexOf(v)===-1) state.excludedDates.push(v);
    saveExcluded();
    document.getElementById('inpExcludeDate').value='';
    renderExcludedList();
    render();
  };

  document.getElementById('openSettings').onclick = function(){
    document.getElementById('inpBudget').value = state.budget || '';
    document.getElementById('inpPeriodStart').value = state.periodStartDay || 1;
    document.getElementById('inpPeriodEnd').value = state.periodEndDay || 31;
    renderSwatches();
    renderExcludedList();
    openSheet('settingsOverlay');
  };
  document.getElementById('saveBudget').onclick = function(){
    var v = Number(document.getElementById('inpBudget').value)||0;
    var p = Number(document.getElementById('inpPeriodStart').value)||1;
    var pe = Number(document.getElementById('inpPeriodEnd').value)||31;
    if(p<1) p=1;
    if(p>31) p=31;
    if(pe<1) pe=1;
    if(pe>31) pe=31;
    state.budget = v;
    state.periodStartDay = p;
    state.periodEndDay = pe;
    saveBudget();
    savePeriodStart();
    savePeriodEnd();
    render();
    closeSheet('settingsOverlay');
  };

  document.getElementById('prevMonth').onclick = function(){
    state.viewMonth--;
    if(state.viewMonth<0){ state.viewMonth=11; state.viewYear--; }
    render();
  };
  document.getElementById('nextMonth').onclick = function(){
    state.viewMonth++;
    if(state.viewMonth>11){ state.viewMonth=0; state.viewYear++; }
    render();
  };

  document.getElementById('exportBtn').onclick = function(){
    var payload = {
      app: 'lunch-budget',
      exportedAt: new Date().toISOString(),
      budget: state.budget,
      entries: state.entries,
      excludedDates: state.excludedDates,
      colorId: state.colorId,
      periodStartDay: state.periodStartDay,
      periodEndDay: state.periodEndDay
    };
    var blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    var stamp = fmtKey(new Date());
    a.href = url;
    a.download = 'lunch-budget-backup-'+stamp+'.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  };

  document.getElementById('importBtn').onclick = function(){
    document.getElementById('importFile').click();
  };
  document.getElementById('importFile').onchange = function(ev){
    var file = ev.target.files[0];
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(){
      try{
        var data = JSON.parse(reader.result);
        if(!data || !Array.isArray(data.entries)) throw new Error('형식 오류');
        if(!confirm('백업 파일을 불러오면 현재 기록이 모두 대체돼요. 계속할까요?')) return;
        state.entries = data.entries;
        state.budget = Number(data.budget)||0;
        state.excludedDates = Array.isArray(data.excludedDates) ? data.excludedDates : [];
        state.colorId = data.colorId || 'blue';
        state.periodStartDay = Number(data.periodStartDay)||1;
        state.periodEndDay = Number(data.periodEndDay)||31;
        saveEntries();
        saveBudget();
        saveExcluded();
        saveColor();
        savePeriodStart();
        savePeriodEnd();
        applyColor(state.colorId);
        renderSwatches();
        renderExcludedList();
        render();
        closeSheet('settingsOverlay');
        alert('백업을 불러왔어요.');
      }catch(err){
        alert('올바른 백업 파일이 아니에요.');
      }
      ev.target.value = '';
    };
    reader.readAsText(file);
  };

  async function init(){
    await loadData();
    applyColor(state.colorId);
    state.viewYear = today.getFullYear();
    state.viewMonth = today.getMonth();
    render();
    document.getElementById('loading').style.display='none';
    document.getElementById('app').style.display='flex';
  }
  init();
})();
</script>
</body>
</html>
